# ── Языковая модель (OpenAI-совместимый API; по умолчанию NVIDIA API Catalog) ──
LLM_PROVIDER=nvidia
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx     # ключ: build.nvidia.com → Get API Key
# адрес и модель берутся из пресета поставщика; переопределить при необходимости:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=minimaxai/minimax-m3.1-flash
# LLM_JUDGE_MODEL=                            # одна модель для всех оценщиков отчётов
# Своя модель у каждого оценщика (по умолчанию для NVIDIA — ultra у строгого и лояльного, gpt-oss у объективного, см. settings.py);
# «same» — все оценщики на одной модели; «@nothink» — без этапа рассуждения:
# LLM_JUDGE_MODELS=strict=nvidia/nemotron-3-ultra-550b-a55b@nothink,objective=openai/gpt-oss-20b,loyal=nvidia/nemotron-3-ultra-550b-a55b@nothink
# Описание рисунков отчёта моделью зрения
# VISION_ENABLED=true
# VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# VISION_MAX_IMAGES=12
# Арбитр: при голосах 2:1 решают два «сильных» оценщика, если оба уверены (правило A6)
# AGG_STRONG_JUDGES=strict,objective
# AGG_STRONG_MIN_CONFIDENCE=0.8
# Правило R7 (соответствие отчёта своей лабораторной по эмбеддингам)
# LAB_MATCH_ENABLED=true
# LAB_MATCH_MIN_SIM=0.45
# LAB_MATCH_MARGIN=0.05
# Одновременных фоновых проверок отчётов
# VERIFICATION_CONCURRENCY=4
LLM_TEMPERATURE=0.3
# Другие поставщики (меняются одной строкой LLM_PROVIDER + ключ):
#   LLM_PROVIDER=openrouter   LLM_API_KEY=sk-or-v1-...
#   LLM_PROVIDER=groq         LLM_API_KEY=gsk_...   (эмбеддингов нет — EMBEDDING_PROVIDER=local)

# ── Эмбеддинги: nvidia | openrouter | local (t2v-transformers, без ключа) | hash (без сети, для тестов) ──
EMBEDDING_PROVIDER=nvidia
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b

# ── Параметры гибридной проверки отчётов ──
SIMHASH_MAX_HAMMING=10
REPORT_MIN_WORDS=120
AGG_APPROVE_THRESHOLD=0.65
AGG_REJECT_THRESHOLD=0.35

# ── Безопасность ──
AUTH_SECRET=замените-на-длинную-случайную-строку
# Демонстрационные курсы и пользователи при первом запуске (teacher1/teacher1, student1/student1 …);
# false — запуск с пустой базой
# SEED_DEMO=true

# ── База данных ──
EDUCATION_DATABASE_USER=postgres
EDUCATION_DATABASE_PASS=postgres
EDUCATION_DATABASE_NAME=education_database

# ── Прокси для доступа к API модели (необязательно) ──
# HTTPS_PROXY=http://login:password@host:port
